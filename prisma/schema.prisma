generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  watchlists Watchlist[]
  alerts     Alert[]
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  user      User     @relation(fields: [userId], references: [id])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  ticker    String
  condition String   // e.g., "PROB_UP_GT_80"
  user      User     @relation(fields: [userId], references: [id])
}

// 🧪 AI Track Record - Stores predictions to calculate historical accuracy
model Prediction {
  id              String   @id @default(cuid())
  ticker          String
  predictedDate   DateTime @default(now())
  timeHorizonDays Int      // 1, 7, 30, 90
  
  // Predictions
  probUp          Float
  probDown        Float
  probFlat        Float
  confidence      String
  
  // Real Data (At time of prediction)
  priceAtPrediction Float
  
  // Backtesting Resolution
  resolved        Boolean  @default(false)
  actualPrice     Float?
  actualReturn    Float?
  wasCorrect      Boolean?
}
